# ==================================
# EduCore Backend Environment Config
# ==================================

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/educore_db
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/educore_db
MONGO_URI=mongodb://127.0.0.1:27017/educore_db

# JWT Secret — Generate a strong random string
JWT_SECRET=educore_super_secret_jwt_key_sprint15

# Server Port
PORT=5000

# Stripe Keys (Test Mode — Phase 3 Monetization)
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
